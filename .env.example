# Get your token from @BotFather on Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Your personal Telegram chat ID — the bot will alert you on repeated API failures.
# Send /start to @userinfobot to find your chat ID.
ADMIN_CHAT_ID=your_telegram_chat_id_here

# Only required once a user runs /login: encrypts the fallback password
# stored so the auto-booking watcher can silently re-login if a
# refresh_token has also expired. Generate one with: openssl rand -hex 32
ENCRYPTION_KEY=

# Optional. How long (ms) the fetched venues list is cached in memory before
# re-fetching from GET /api/v1/venues — see src/services/venue.service.js.
# Defaults to 720000 (12 minutes) if unset.
VENUE_CACHE_TTL_MS=
